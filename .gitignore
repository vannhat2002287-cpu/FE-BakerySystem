
# File cấu hình Git - Định nghĩa các file/folder không được track bởi Git

# Dependencies - thư viện npm (cài lại bằng npm install)
node_modules

# Logs - file log debug
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output - folder build (tạo lại bằng npm run build)
dist
dist-ssr
*.local

# Editor/IDE - cấu hình editor cá nhân
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables - file chứa secrets, không commit lên Git
.env
.env.production
.env.development